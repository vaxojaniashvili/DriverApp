{
  "expo": {
    "name": "TheVanApp Driver",
    "slug": "DriverApp",
    "version": "3.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "duration": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ivexinio.thevanappdriverapp",
      "config": {
        "googleMapsApiKey": "AIzaSyDehqBa4oYIB8IbD6z07_X8hU9Q9BhW-9Y"
      },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.ivexinio.thevanappdriverapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDehqBa4oYIB8IbD6z07_X8hU9Q9BhW-9Y"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TheVanApp to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": ["./assets/sounds/notification.wav"]
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/notification_icon.png",
      "color": "#ffffff",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "new notification"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "af101e84-7fa6-46eb-bc1d-beb8833d3de7"
      }
    }
  }
}
