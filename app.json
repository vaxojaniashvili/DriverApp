{
  "expo": {
    "name": "DriverApp",
    "slug": "DriverApp",
    "version": "3.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ivexinio.thevanappdriverapp",
      "config": {
        "googleMapsApiKey": "AIzaSyDehqBa4oYIB8IbD6z07_X8hU9Q9BhW-9Y"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "package": "com.ivexinio.thevanappdriverapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDehqBa4oYIB8IbD6z07_X8hU9Q9BhW-9Y"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TheVanApp to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "af101e84-7fa6-46eb-bc1d-beb8833d3de7"
      }
    }
  }
}
